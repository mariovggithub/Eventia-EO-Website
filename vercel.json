{
  "version": 2,
  "framework": null,

  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.4"
    }
  },

  "routes": [
    {
      "src": "/build/(.*)",
      "dest": "/public/build/"
    },
    { 
      "src": "/(.*)",
      "dest": "/api/index.php"
    },
    {
      "src": "/public/assets/(.*)",
      "dest": "/public/assets/"
    }
  ],

  "env": {
    "APP_ENV": "production",
    "APP_DEBUG": "true",
    "LOG_CHANNEL": "stderr",
    "CACHE_DRIVER": "array",
    "SESSION_DRIVER": "cookie",
    "VIEW_COMPILED_PATH": "/tmp"
  }
}